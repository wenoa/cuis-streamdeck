{
  "name": "cuis-streamdeck",
  "version": "0.0.0",
  "description": "Stream Deck plugin to control Cuis Smalltalk",
  "author": "Wenoa Studio <https://wenoa.studio>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/wenoa/cuis-streamdeck.git"
  },
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart studio.wenoa.cuis\"",
    "pack": "streamdeck pack studio.wenoa.cuis.sdPlugin",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "type": "module",
  "devDependencies": {
    "@elgato/cli": "^1.10.1",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-swc": "^0.4.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@swc/core": "^1.16.13",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "rollup": "^4.64.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.1"
  }
}
